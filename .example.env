# Copy to .env and adjust for your services. Process environment variables win.
POSTGRES_DB=tenderhack
POSTGRES_USER=tenderhack
POSTGRES_PASSWORD=tenderhack
POSTGRES_PORT=5432
POSTGRES_IP=127.0.0.1
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_IP}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=4
DATABASE_POOL_TIMEOUT_SECONDS=10
KTRU_CATALOG_KEY=ktru

CLASSIFIER_BASE_URL=http://127.0.0.1:8769
CLASSIFIER_MODEL=jiwo-4b
CLASSIFIER_TIMEOUT_SECONDS=180
CLASSIFIER_HEALTH_TIMEOUT_SECONDS=5
# Merge product, categorical and numeric questions per HTTP call; 0 disables packing.
CLASSIFIER_BATCH_SIZE=16

EMBEDDING_BASE_URL=http://127.0.0.1:8067
EMBEDDING_MODEL=google/embeddinggemma-2
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_NAMES=4
# Standalone experiment cache and legacy import source; backend vectors live in PostgreSQL.
EMBEDDING_CACHE_PATH=backend/cache/catalog_embeddings.json
# Quotes preserve the trailing space required by these model prefixes.
EMBEDDING_QUERY_PROMPT="task: search result | query: "
EMBEDDING_DOCUMENT_PROMPT="title: none | text: "

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=info
# Legacy import paths; the backend no longer writes runs or startup logs here.
BACKEND_RESULTS_DIR=backend/results
BACKEND_STARTUP_LOG_PATH=backend/results/startup_connections.jsonl
STARTUP_CHECK_TIMEOUT_SECONDS=5
BACKEND_MAX_QUESTIONS=128
# Bootstrap/import source, used only when the configured database catalog is empty.
KTRU_CATALOG_PATH=experiments/results/catalog.json
KTRU_XML_DIR=data
EXPERIMENT_RESULTS_DIR=experiments/results

# Search history (Redis)
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
HISTORY_TTL_SECONDS=604800
HISTORY_MAX_ITEMS=5

# Default request values; API callers and CLI flags can override these.
PIPELINE_TOP_K=8
PIPELINE_CHUNK_SIZE=4
PIPELINE_THRESHOLD=0.8
